{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/*.tsx",
    "scripts/*.ts",
    "eslint-rules/index.mjs",
    "src/api/queries/*.ts",
    "src/api/pending-types.ts",
    "src/hooks/use-streaming-turn.ts",
    "playwright.serve.config.ts",
    "e2e/serve/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**",
    "src/api/schema.d.ts"
  ],
  "ignoreDependencies": [
    "shadcn",
    "tw-animate-css",
    "@fontsource-variable/geist-mono",
    "tailwindcss"
  ]
}
